:root {
}

.Button {
    font-size: 65px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Richocet%20Bold.ttf?fileID=12800000&guid=e686d0aff31becd43a1d7b89b7f45b71&type=3#Richocet Bold");
    letter-spacing: 5px;
    flex-shrink: 0;
    background-color: rgb(196, 214, 191);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.Button:hover {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
    background-color: rgba(146, 161, 141, 0.64);
    flex-shrink: 0;
}
