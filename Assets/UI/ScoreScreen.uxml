<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Button/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=1d6a3709013766c4392b3f1ce4e8ee10&amp;type=3#ButtonStyle" />
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; align-self: center; flex-shrink: 0; top: 20%; width: 700px; height: 700px; background-color: rgb(106, 142, 108); position: relative; bottom: auto; right: auto; left: auto; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
            <ui:VisualElement name="TextContainer" style="flex-grow: 1;">
                <ui:Label text="Current Highscore" name="Highscore" style="align-self: center; font-size: 80px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Richocet%20Bold.ttf?fileID=12800000&amp;guid=e686d0aff31becd43a1d7b89b7f45b71&amp;type=3#Richocet Bold&quot;); top: 25px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px;" />
                <ui:Label text="Score This Round" name="CurrentScore" style="align-self: center; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Richocet%20Bold.ttf?fileID=12800000&amp;guid=e686d0aff31becd43a1d7b89b7f45b71&amp;type=3#Richocet Bold&quot;); top: 150px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255);" />
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1;">
                <ui:Button text="Restart" name="restartButton" class="Button" style="top: 25%; width: 600px; align-self: center; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
